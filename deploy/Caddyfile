# Proxy inverse de production (PR D3). HTTPS automatique (Let's Encrypt).
#
# ⚠️ L'API N'A QU'UNE ROUTE PUBLIQUE : le webhook Stripe. Le navigateur ne parle
# jamais à l'API — le serveur web l'appelle sur http://api:5000, par le réseau
# Docker. Tout le reste de linkrapp.com va au web, y compris /api/*, qui sont
# les relais BFF de Next (les envoyer à NestJS casserait l'application).

{
	email {$ACME_EMAIL}
}

# En-têtes d'identité du client, posés vers le web ET vers l'API (PR D2).
#
# ⚠️ AUCUNE VALEUR FOURNIE PAR LE CLIENT NE PASSE. X-Forwarded-For est ÉCRASÉ
# par l'adresse que Caddy voit réellement ({remote_host} : le pair TCP — aucun
# proxy de confiance n'est déclaré devant Caddy). X-Real-IP est supprimé : rien
# ne le lit, et le laisser passer offrirait un en-tête forgé à qui le lirait un
# jour. Le web relaie ensuite CETTE adresse à l'API, qui ne croit le relais que
# depuis le réseau Docker (TRUSTED_PROXY_IPS, deploy/compose.yaml).
# Trace mesurée (smoke D2) : le web reçoit exactement une adresse, Next
# n'ajoute rien.
(client_ip_headers) {
	header_up X-Forwarded-For {remote_host}
	header_up -X-Real-IP
}

www.linkrapp.com {
	redir https://linkrapp.com{uri} permanent
}

linkrapp.com {
	encode zstd gzip

	# En-têtes de base. Le préfixe `?` ne pose la valeur que si l'application ne
	# l'a pas déjà fait : /reset-password garde son `no-referrer` (Next).
	# strict-origin-when-cross-origin : MapTiler et Stripe.js ne reçoivent que
	# l'origine, jamais l'URL de /recherche (qui porte le point cherché).
	# Aucune Content-Security-Policy ici : elle demanderait d'énumérer Stripe.js,
	# ses iframes 3D Secure et MapTiler — PR dédiée.
	header {
		Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@stripe_webhook {
		method POST
		path /webhooks/stripe /webhooks/stripe/*
	}
	handle @stripe_webhook {
		reverse_proxy api:5000 {
			import client_ip_headers
		}
	}

	handle {
		reverse_proxy web:3001 {
			import client_ip_headers
		}
	}
}
