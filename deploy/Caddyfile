# Proxy inverse de production (PR D3). HTTPS automatique (Let's Encrypt).
#
# ⚠️ L'API N'A QU'UNE ROUTE PUBLIQUE : le webhook Stripe. Le navigateur ne parle
# jamais à l'API — le serveur web l'appelle sur http://api:5000, par le réseau
# Docker. Tout le reste de linkrapp.com va au web, y compris /api/*, qui sont
# les relais BFF de Next (les envoyer à NestJS casserait l'application).

{
	email {$ACME_EMAIL}
}

# En-têtes d'identité du client, posés vers le web ET vers l'API (PR D2).
#
# ⚠️ AUCUNE VALEUR FOURNIE PAR LE CLIENT NE PASSE. X-Forwarded-For est ÉCRASÉ
# par l'adresse que Caddy voit réellement ({remote_host} : le pair TCP — aucun
# proxy de confiance n'est déclaré devant Caddy). X-Real-IP et X-Client-IP
# sont supprimés : rien ne les lit, et les laisser passer offrirait un en-tête
# forgé à qui les lirait un jour. Le web relaie ensuite CETTE adresse à l'API,
# qui ne croit le relais que depuis le réseau Docker (TRUSTED_PROXY_IPS, deploy/compose.yaml).
# Trace mesurée (smoke D2) : le web reçoit exactement une adresse, Next
# n'ajoute rien.
(client_ip_headers) {
	header_up X-Forwarded-For {remote_host}
	header_up -X-Real-IP
	header_up -X-Client-IP
}

www.linkrapp.com {
	redir https://linkrapp.com{uri} permanent
}

linkrapp.com {
	encode zstd gzip

	# En-têtes de base. Le préfixe `?` ne pose la valeur que si l'application ne
	# l'a pas déjà fait : /reset-password garde son `no-referrer` (Next).
	# strict-origin-when-cross-origin : MapTiler et Stripe.js ne reçoivent que
	# l'origine, jamais l'URL de /recherche (qui porte le point cherché).
	# Aucune Content-Security-Policy ici : elle demanderait d'énumérer Stripe.js,
	# ses iframes 3D Secure et MapTiler — PR dédiée.
	header {
		Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@stripe_webhook {
		method POST
		path /webhooks/stripe /webhooks/stripe/*
	}
	handle @stripe_webhook {
		reverse_proxy api:5000 {
			import client_ip_headers
		}
	}

	# ⚠️ ARRÊT D'URGENCE SANS DÉPLOIEMENT (mandat E). Deux drapeaux, un fichier
	# chacun dans /opt/linkr/flags (monté en lecture seule sur /etc/caddy/flags) :
	#   maintenance     → toutes les pages répondent 503 (page statique)
	#   signups-closed  → /signup et POST /api/auth/signup répondent 503
	# Le matcher `file` fait un stat À CHAQUE REQUÊTE : poser ou retirer le fichier
	# suffit, ni rechargement ni redémarrage ni déploiement. Absent = comportement
	# inchangé. Le webhook Stripe est servi AVANT (handle ci-dessus), donc joignable
	# dans les deux cas. Les `handle` sont exclusifs et lus dans l'ordre : ne jamais
	# placer le proxy web avant eux. Mode d'emploi : docs/deploy/arret-urgence.md.
	@maintenance file {
		root /etc/caddy/flags
		try_files maintenance
	}
	handle @maintenance {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		header Retry-After "600"
		respond <<HTML
			<!doctype html>
			<html lang="fr-CA"><head><meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<meta name="robots" content="noindex, nofollow">
			<title>Maintenance · Linkr</title></head>
			<body style="font-family:system-ui,sans-serif;background:#F3EBDF;color:#2E211E;margin:0;display:grid;place-items:center;min-height:100vh;padding:1rem;text-align:center">
			<main><h1 style="margin:0 0 .5rem">Linkr est en maintenance</h1>
			<p style="margin:0">Le service est momentanément indisponible. Veuillez réessayer dans quelques minutes.</p></main>
			</body></html>
			HTML 503
	}

	# Page d'inscription (GET /signup) : page statique en français.
	@signups_closed_page {
		path /signup /signup/
		file {
			root /etc/caddy/flags
			try_files signups-closed
		}
	}
	handle @signups_closed_page {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		respond <<HTML
			<!doctype html>
			<html lang="fr-CA"><head><meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<meta name="robots" content="noindex, nofollow">
			<title>Inscriptions fermées · Linkr</title></head>
			<body style="font-family:system-ui,sans-serif;background:#F3EBDF;color:#2E211E;margin:0;display:grid;place-items:center;min-height:100vh;padding:1rem;text-align:center">
			<main><h1 style="margin:0 0 .5rem">Inscriptions temporairement fermées</h1>
			<p style="margin:0 0 1rem">Nous n'acceptons pas de nouveaux comptes pour le moment. Veuillez réessayer plus tard.</p>
			<p style="margin:0"><a href="/login" style="color:#6E1E2B">Se connecter</a></p></main>
			</body></html>
			HTML 503
	}

	# Relais d'inscription (POST /api/auth/signup) : un appel direct à l'API web
	# ne doit pas contourner la fermeture. JSON, même message.
	@signups_closed_relay {
		path /api/auth/signup /api/auth/signup/
		file {
			root /etc/caddy/flags
			try_files signups-closed
		}
	}
	handle @signups_closed_relay {
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "no-store"
		respond `{"message":"Les inscriptions sont temporairement fermées. Veuillez réessayer plus tard."}` 503
	}

	handle {
		reverse_proxy web:3001 {
			import client_ip_headers
		}
	}
}
