# Variables d'exécution de l'API (deploy/compose.yaml, service `api`).
# Copier en deploy/api.env sur le serveur, chmod 600. Jamais commité (.gitignore).
# AUCUNE valeur secrète dans ce fichier d'exemple. Inventaire : docs/deploy/env.md.
#
# Posées par le compose (ne pas les mettre ici, elles seraient ignorées) :
# NODE_ENV, PORT, DATABASE_URL, REDIS_URL, STORAGE_DRIVER, STORAGE_LOCAL_DIR,
# TRUSTED_PROXY_IPS.

LOG_LEVEL=log

# TRUSTED_PROXY_IPS est posé par le compose (sous-réseau du réseau edge,
# PR D2) : ne pas le mettre ici, il serait ignoré.

# JWT : deux secrets différents, 32+ caractères (openssl rand -hex 32).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Stripe — clés de TEST pendant toute la version d'essai.
STRIPE_SECRET_KEY=
# Secret du point de terminaison https://linkrapp.com/webhooks/stripe (tableau de bord Stripe).
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Étiquette posée sur chaque objet Stripe créé (metadata.linkr_env). Obligatoire, jamais « dev ».
STRIPE_ENV_LABEL=trial

WEB_APP_BASE_URL=https://linkrapp.com
CONNECT_ONBOARDING_RETURN_URL=https://linkrapp.com/dashboard/paiements/retour
CONNECT_ONBOARDING_REFRESH_URL=https://linkrapp.com/dashboard/paiements/reprise

PLATFORM_COMMISSION_RATE_PERCENT=10
PLATFORM_DEPOSIT_RATE_PERCENT=20
PLATFORM_AUTO_RELEASE_HOURS=72
PLATFORM_DEFAULT_CURRENCY=CAD

# Brevo (relais SMTP, STARTTLS sur 587). Identifiant et clé SMTP de Brevo,
# à poser ensemble (l'un sans l'autre fait échouer le démarrage).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@linkrapp.com
EMAIL_FROM_NAME=Linkr
# Plafond quotidien (jour en heure de Toronto) des courriels non essentiels. Facultatif, 200 par
# défaut : ne rien ajouter suffit. Brevo gratuit = 300 envois par jour.
# EMAIL_DAILY_BUDGET=200
# Plafonds quotidiens (jour de Toronto) des courriels de confirmation d'adresse : à
# l'inscription, et des renvois (compteurs distincts). Au plafond d'inscription,
# l'inscription répond 503 sans créer de compte. 200 + 40 + 20 = 260 sur 300 (Brevo gratuit).
# EMAIL_VERIFICATION_DAILY_BUDGET=40
# EMAIL_VERIFICATION_RESEND_DAILY_BUDGET=20

NOMINATIM_USER_AGENT=Linkr/1.0 (support@linkrapp.com)
