# Variables du compose de production (deploy/compose.yaml).
# Copier en deploy/.env sur le serveur, chmod 600. Jamais commité (.gitignore).
# AUCUNE valeur secrète dans ce fichier d'exemple.

# Tag des images GHCR à déployer : le SHA complet du commit (recommandé) ou `latest`.
IMAGE_TAG=

# Adresse du compte Let's Encrypt (avis d'expiration des certificats).
ACME_EMAIL=

# Postgres/PostGIS. Mot de passe : caractères hexadécimaux seulement
# (openssl rand -hex 32), il est inséré tel quel dans DATABASE_URL.
POSTGRES_USER=linkr
POSTGRES_PASSWORD=
POSTGRES_DB=linkr
