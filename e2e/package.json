{
  "name": "@linkr/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Tests de fumée Playwright, lancés à la main contre l'essai. Paquet autonome, hors workspace.",
  "scripts": {
    "test": "playwright test",
    "test:list": "playwright test --list",
    "test:paiement": "playwright test --config playwright.payment.config.ts",
    "test:paiement:list": "playwright test --config playwright.payment.config.ts --list",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
