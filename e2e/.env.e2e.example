# Copier en .env.e2e (ignoré par Git) et renseigner. Aucune valeur réelle ici.
# URL de base de l'essai, sans barre finale. OBLIGATOIRE : aucune valeur par défaut.
E2E_BASE_URL=

# Comptes : adresses FIXES e2e-prestataire@linkrapp.com et e2e-client@linkrapp.com
# (règles Cloudflare Email Routing). Jamais d'alias e2e+…@gmail.com : la partie
# locale « e2e » est la boîte d'un inconnu. Sans rien ici, la suite inscrit chaque
# compte avec un mot de passe aléatoire et le mémorise dans e2e/.auth/accounts.json.
# - E2E_*_EMAIL : remplace l'adresse fixe (adresse @linkrapp.com seulement).
# - E2E_*_PASSWORD : mot de passe d'un compte déjà inscrit dont accounts.json ne
#   connaît pas le mot de passe (autre poste). L'inscription est quand même tentée ;
#   un « courriel déjà utilisé » mène alors à la connexion avec ce mot de passe.
E2E_PROVIDER_EMAIL=
E2E_PROVIDER_PASSWORD=
E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=

# Parcours de paiement (pnpm test:paiement seulement). Consentement explicite :
# le parcours refuse de démarrer si cette variable ne vaut pas exactement « 1 ».
# Laisser vide ici ; la poser dans le terminal au moment de lancer.
E2E_ALLOW_PAYMENT=
