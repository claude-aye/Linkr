# Copier en .env.e2e (ignoré par Git) et renseigner. Aucune valeur réelle ici.
# URL de base de l'essai, sans barre finale. OBLIGATOIRE : aucune valeur par défaut.
E2E_BASE_URL=
# Comptes réutilisés d'un lancement à l'autre. Laisser vide pour que la suite les crée
# (courriel e2e+...@gmail.com), puis les mémorise dans e2e/.auth/accounts.json.
E2E_PROVIDER_EMAIL=
E2E_PROVIDER_PASSWORD=
E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=
