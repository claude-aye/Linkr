# Base URL of the Linkr API (NestJS). The 3.11a manual-validation flow runs the
# API on port 5000 (see PROMPT_CC_3_11a §7). Copy this file to .env.local.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Stripe publishable key, used by Stripe.js in the browser to collect and
# authenticate a card on /account/payment-methods.
#
# ⚠️ IT DUPLICATES `STRIPE_PUBLISHABLE_KEY` OF apps/api/.env ON PURPOSE, and the
# duplication cannot be removed. A `NEXT_PUBLIC_*` value is INLINED AT BUILD
# TIME into the JavaScript served to the browser: there is no runtime read, so
# the web app cannot ask the API for it, and nothing would be gained if it
# could — a publishable key is public by definition (it is shipped to every
# visitor either way). The two values must simply be kept on the same Stripe
# account: a `pk_` from one account and an `sk_` from another produce a
# SetupIntent whose client secret the browser is not allowed to confirm.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_change_me
