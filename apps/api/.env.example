NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://linkr:linkr_dev_password@localhost:5432/linkr
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug

# JWT — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_use_openssl_rand_hex_32_for_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_use_openssl_rand_hex_32_for_refresh_different_from_access
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (optional — leave blank to disable; /auth/google will return 503)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Apple Sign-In (optional — leave blank to disable; /auth/apple will return 503)
# APPLE_OAUTH_CLIENT_ID=
# APPLE_OAUTH_TEAM_ID=
# APPLE_OAUTH_KEY_ID=
# APPLE_OAUTH_PRIVATE_KEY=
# APPLE_OAUTH_CALLBACK_URL=http://localhost:3000/auth/apple/callback

# Storage (verification documents) — local disk in dev, S3-compatible in prod
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
# Required when STORAGE_DRIVER=s3 (AWS S3 ca-central-1 or Cloudflare R2):
# STORAGE_BUCKET=linkr-uploads
# STORAGE_REGION=ca-central-1
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=

# Geocoding (port/adapter) — Nominatim (OpenStreetMap) proxy for GET /geocode
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# REQUIRED (no default) — Nominatim ToS mandates a descriptive User-Agent with a
# real contact. Set it to your app + contact, e.g. Linkr/1.0 (you@example.com).
NOMINATIM_USER_AGENT=Linkr/1.0 (dev@linkr.test)

# Stripe (required at boot) — prefixes are validated (sk_ / whsec_ / pk_)
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_PUBLISHABLE_KEY=pk_test_change_me
# DORMANT in 3.10a — Account Links onboarding does not use Connect OAuth
# STRIPE_CONNECT_CLIENT_ID=ca_...

# Stripe Connect Express onboarding redirect targets (Account Links)
CONNECT_ONBOARDING_RETURN_URL=http://localhost:3000/connect/return
CONNECT_ONBOARDING_REFRESH_URL=http://localhost:3000/connect/refresh

# Platform economics (3.10b) — required at boot; snapshotted on each payment
PLATFORM_COMMISSION_RATE_PERCENT=10.00
PLATFORM_DEPOSIT_RATE_PERCENT=20.00
PLATFORM_DEFAULT_CURRENCY=CAD
# Hours a COMPLETED, non-contested request waits before the 80% balance
# auto-releases (3.10c) — required at boot
PLATFORM_AUTO_RELEASE_HOURS=72

# Outbound email (chantier A-1) — local dev points at the Mailpit container
# from docker/docker-compose.yml, which accepts unauthenticated SMTP on 1025
# and serves its web UI on http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Optional, and Mailpit needs neither. Set BOTH or NEITHER (the env schema
# refuses one without the other). NEVER commit real credentials here.
# SMTP_USER=
# SMTP_PASSWORD=
# Sender identity — required at boot, no default (see env.validation.ts).
EMAIL_FROM_ADDRESS=no-reply@linkr.test
EMAIL_FROM_NAME=Linkr
